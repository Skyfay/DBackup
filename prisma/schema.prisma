generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdapterConfig {
  id                           String                        @id @default(uuid())
  name                         String
  type                         String
  adapterId                    String
  config                       String
  metadata                     String? // Stores non-sensitive runtime data (e.g., version, connection status)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  jobsSource                   Job[]                         @relation("Source")
  jobsNotification             Job[]                         @relation("Notifications")
  jobDestinations              JobDestination[]
  jobSources                   JobSource[]                   @relation("JobSourceConfig")
  notificationTemplateChannels NotificationTemplateChannel[]

  // Storage adapters only (app enforces this): a config is either a backup destination or
  // a directory backup source, never both. A destination owns its configured root - backups
  // and their chain folders are written into it - while a source only reads the folders
  // picked for it. Sharing one config would let a job back up its own archives.
  // DESTINATION | SOURCE, see STORAGE_ROLES in src/lib/core/storage-roles.ts.
  storageRole String @default("DESTINATION")

  // Credential profile references (Phase 1: nullable; app enforces required-ness based on adapter type)
  primaryCredentialId String?
  primaryCredential   CredentialProfile? @relation("PrimaryCredential", fields: [primaryCredentialId], references: [id], onDelete: Restrict)
  sshCredentialId     String?
  sshCredential       CredentialProfile? @relation("SshCredential", fields: [sshCredentialId], references: [id], onDelete: Restrict)

  // Default retention policy for storage destinations (pre-fills job form when destination is added)
  defaultRetentionPolicyId String?
  defaultRetentionPolicy   RetentionPolicy? @relation(fields: [defaultRetentionPolicyId], references: [id], onDelete: SetNull)

  // Caching-Felder für schnelle UI-Anzeige ohne Joins
  lastHealthCheck     DateTime?
  lastStatus          String    @default("ONLINE") // ONLINE, DEGRADED, OFFLINE
  lastError           String? // Human-readable reason when lastStatus != ONLINE (e.g. "No credential profile assigned")
  consecutiveFailures Int       @default(0) // Zähler für Logik (Grün -> Orange -> Rot)

  healthLogs        HealthCheckLog[]
  versionHistory    DbVersionHistory[]
  storageListCaches StorageListCache[]
  databaseListCache DatabaseListCache?
  // A destination or a channel its tenant shares with other tenants, and the recipients they name.
  share             ConnectionShare?
  channelRecipients ChannelRecipients[]
  // The tenant the row belongs to, see src/lib/tenant/prisma-scope.ts. The default only fills the
  // rows of the migration, the client names the tenant of every new row itself.
  tenantId          String              @default("default")

  @@index([tenantId])
}

model CredentialProfile {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String // USERNAME_PASSWORD | SSH_KEY | ACCESS_KEY | TOKEN | SMTP
  data        String // Encrypted JSON payload (encrypt(JSON.stringify(payload)))
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  primaryAdapters AdapterConfig[] @relation("PrimaryCredential")
  sshAdapters     AdapterConfig[] @relation("SshCredential")
  tenantId        String          @default("default") // See AdapterConfig.tenantId

  @@unique([tenantId, name])
}

model EncryptionProfile {
  id              String    @id @default(cuid())
  name            String
  description     String?
  secretKey       String
  jobs            Job[]
  // The last recovery kit that held this key. Kept here, since the audit log is cleaned after a while.
  kitDownloadedAt DateTime?
  // JSON array of other profile ids whose backups this key opens, a deleted one or one of another
  // install, noted whenever a restore or a recovery matched it.
  aliases         String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenantId        String    @default("default") // See AdapterConfig.tenantId

  @@index([tenantId])
}

model RetentionPolicy {
  id              String           @id @default(cuid())
  name            String
  description     String?
  config          String // JSON RetentionConfiguration (same format as legacy JobDestination.retention)
  isDefault       Boolean          @default(false)
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobDestinations JobDestination[]
  adapterConfigs  AdapterConfig[]
  tenantId        String           @default("default") // See AdapterConfig.tenantId

  @@unique([tenantId, name])
}

model NamingTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  pattern     String // e.g. "{name}_yyyy-MM-dd_HH-mm-ss"
  isDefault   Boolean  @default(false) // Only one can be true at a time
  isSystem    Boolean  @default(false) // System templates are read-only in the UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]
  tenantId    String   @default("default") // See AdapterConfig.tenantId

  @@unique([tenantId, name])
}

model SchedulePreset {
  id          String   @id @default(cuid())
  name        String
  description String?
  schedule    String // Cron expression (5-part format)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]
  tenantId    String   @default("default") // See AdapterConfig.tenantId

  @@unique([tenantId, name])
}

model ExcludePatternPreset {
  id                    String      @id @default(cuid())
  name                  String
  description           String?
  patterns              String // JSON array of the preset's OWN glob patterns, on top of any groups below
  groups                String      @default("[]") // JSON array of curated group ids from src/lib/exclude-groups.ts - referenced, not copied, so releases can extend them
  excludedGroupPatterns String      @default("[]") // JSON array of individual group patterns this preset opts out of
  isDefault             Boolean     @default(false) // Pre-selected on newly added directory sources; several may be default
  isSystem              Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  jobSources            JobSource[]
  tenantId              String      @default("default") // See AdapterConfig.tenantId

  @@unique([tenantId, name])
}

model Job {
  id                    String                    @id @default(uuid())
  name                  String
  schedule              String
  enabled               Boolean                   @default(true)
  sourceId              String?
  databases             String                    @default("[]") // JSON array of database names to back up (e.g. ["db1","db2"])
  encryptionProfileId   String?
  encryptionProfile     EncryptionProfile?        @relation(fields: [encryptionProfileId], references: [id])
  compression           String                    @default("NONE")
  pgCompression         String                    @default("") // PostgreSQL native dump compression: "" (legacy gzip-6), "NONE", "GZIP:6", "LZ4:1", "ZSTD:3"
  namingTemplateId      String? // References NamingTemplate; null = use system default at runtime
  namingTemplate        NamingTemplate?           @relation(fields: [namingTemplateId], references: [id], onDelete: SetNull)
  schedulePresetId      String? // Live-link to a SchedulePreset; scheduler uses preset.schedule when set
  schedulePreset        SchedulePreset?           @relation(fields: [schedulePresetId], references: [id], onDelete: SetNull)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  executions            Execution[]
  destinations          JobDestination[]
  source                AdapterConfig?            @relation("Source", fields: [sourceId], references: [id], onDelete: Restrict)
  sources               JobSource[]
  notifications         AdapterConfig[]           @relation("Notifications")
  notificationEvents    String                    @default("ALWAYS") // Legacy: "ALWAYS", "FAILURE_ONLY", "SUCCESS_ONLY" - kept for backward compat
  notificationTemplates JobNotificationTemplate[]
  skipVerification      Boolean                   @default(false)
  // Incremental backups (directory sources only - database dumps are always full).
  backupMode            String                    @default("FULL") // "FULL" | "INCREMENTAL"
  fullEveryDays         Int                       @default(7) // Forces a fresh chain this often
  verifyByHash          Boolean                   @default(false) // Hash every file instead of trusting size+mtime
  tenantId              String                    @default("default") // See AdapterConfig.tenantId

  @@index([tenantId])
}

model NotificationTemplate {
  id          String                        @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean                       @default(false)
  isSystem    Boolean                       @default(false)
  channels    NotificationTemplateChannel[]
  jobs        JobNotificationTemplate[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  tenantId    String                        @default("default") // See AdapterConfig.tenantId

  @@unique([tenantId, name])
}

model NotificationTemplateChannel {
  id         String               @id @default(cuid())
  templateId String
  configId   String
  events     String               @default("SUCCESS|PARTIAL|FAILED") // Pipe-separated: SUCCESS, PARTIAL, FAILED
  template   NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  config     AdapterConfig        @relation(fields: [configId], references: [id])

  @@unique([templateId, configId])
}

model JobNotificationTemplate {
  id         String               @id @default(cuid())
  jobId      String
  templateId String
  priority   Int                  @default(0)
  job        Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template   NotificationTemplate @relation(fields: [templateId], references: [id])

  @@unique([jobId, templateId])
}

model JobDestination {
  id                String           @id @default(uuid())
  jobId             String
  configId          String
  priority          Int              @default(0) // Upload order (ascending)
  retention         String           @default("{}") // Legacy: RetentionConfiguration JSON (kept for backward compat)
  retentionPolicyId String? // References RetentionPolicy template; takes precedence over retention JSON
  retentionPolicy   RetentionPolicy? @relation(fields: [retentionPolicyId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  config AdapterConfig @relation(fields: [configId], references: [id])

  @@unique([jobId, configId])
}

model JobSource {
  id                    String                 @id @default(uuid())
  jobId                 String
  configId              String
  priority              Int                    @default(0) // Collection/manifest ordering
  path                  String // Remote path on the storage adapter to pull from
  excludePatterns       String                 @default("[]") // JSON array of job-specific extra glob patterns (in addition to any linked presets' patterns)
  excludePatternPresets ExcludePatternPreset[] // Live-linked templates - re-read fresh at execution time (see 01-initialize.ts); patterns from every linked preset are unioned
  useStagingCache       Boolean                @default(false) // Reserved for a later phase (persistent rsync mirror); unused for now
  // Whether the adapter may stop whatever holds this source open while it is read. Only
  // consulted by adapters that stop anything at all; the rest ignore it. Default true: a
  // consistent backup with a short interruption is what asking for one implies.
  stopContainers        Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  config AdapterConfig @relation("JobSourceConfig", fields: [configId], references: [id], onDelete: Restrict)

  @@unique([jobId, configId, path])
}

model Execution {
  id           String    @id @default(uuid())
  jobId        String?
  type         String    @default("Backup")
  status       String
  logs         String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  size         BigInt?
  path         String?
  metadata     String?
  triggerType  String? // "Manual" | "Scheduler" | "Api"
  triggerLabel String? // e.g. user name, API key name, "Scheduler"
  // Incremental chain bookkeeping. All null for a standalone full backup.
  backupType   String? // "Full" | "Incremental"
  chainId      String? // Shared by the full and every incremental built on it
  baseArchive  String? // Filename of the predecessor, not an Execution id
  chainIndex   Int? // Position in the chain, full = 0
  logicalSize  BigInt? // Full snapshot size, as opposed to `size` which is what was stored
  logsPurgedAt DateTime? // Set when data retention cleared `logs`, so the UI can tell it apart from a run without logs
  job          Job?      @relation(fields: [jobId], references: [id])
  tenantId     String    @default("default") // See AdapterConfig.tenantId

  @@index([startedAt])
  @@index([status, startedAt])
  @@index([jobId, startedAt])
  @@index([logsPurgedAt, startedAt])
  // The Type and Started by filters of the History page count every run. These columns sit
  // behind `logs` in the row, so without an index each count read the logs of every run.
  @@index([type, startedAt])
  @@index([triggerType, triggerLabel])
  // The same lists narrowed to the tenant of the viewer. With one tenant every row holds the same
  // tenantId, so an index on it alone would tell SQLite nothing and could still be picked.
  @@index([tenantId, startedAt])
  @@index([tenantId, status, startedAt])
  @@index([tenantId, type, startedAt])
  @@index([tenantId, triggerType, triggerLabel])
}

model User {
  id                     String           @id
  name                   String
  email                  String           @unique
  emailVerified          Boolean
  image                  String?
  timezone               String           @default("")
  dateFormat             String           @default("P")
  timeFormat             String           @default("p")
  autoRedirectOnJobStart Boolean          @default(true)
  createdAt              DateTime
  updatedAt              DateTime
  twoFactorEnabled       Boolean?
  passkeyTwoFactor       Boolean?         @default(false)
  twoFactor              TwoFactor?
  accounts               Account[]
  passkeys               Passkey[]
  sessions               Session[]
  auditLogs              AuditLog[]
  apiKeys                ApiKey[]
  preferences            UserPreference[]
  avatar                 Avatar?

  // "ADMIN" sees and changes every tenant and the platform: the settings, the sign-in providers,
  // the roles and the tenants. Null for everyone else, whose rights come from their memberships.
  // The pages show it as the built-in platform group Platform admin.
  platformRole    String?
  memberships     TenantMembership[]
  // A group of the platform someone of the MSP holds besides their memberships, null for none.
  // A platform admin holds none, their role covers everything.
  platformGroupId String?
  platformGroup   PlatformGroup?     @relation(fields: [platformGroupId], references: [id], onDelete: SetNull)

  @@index([platformGroupId])
}

// A group of the platform, for the people of the MSP: rights on the instance itself, and rights in
// the tenants of its scope on top of the group someone holds there. Platform admin is no row, it is
// `User.platformRole`.
model PlatformGroup {
  id                  String                @id @default(uuid())
  name                String                @unique
  // The rights on the platform, a JSON list like the permissions of a group.
  platformPermissions String                @default("[]")
  // The rights in every tenant of its scope, a JSON list.
  tenantPermissions   String                @default("[]")
  // Every tenant, the ones made later too. Otherwise the tenants listed in `tenants`.
  allTenants          Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  members             User[]
  tenants             PlatformGroupTenant[]
}

// A tenant in the scope of a platform group that does not cover every tenant.
model PlatformGroupTenant {
  groupId  String
  tenantId String
  group    PlatformGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([groupId, tenantId])
  @@index([tenantId])
}

/// Settings a user makes for themselves in the UI, such as the columns picked for a table.
/// Kept in the account rather than the browser, so they follow the user to every device.
// A customer of the instance, and the boundary of its data: every connection, job, key, run and
// template belongs to one tenant, see src/lib/tenant/. An instance starts with the tenant "default",
// which holds what the platform owns and is never deleted.
model Tenant {
  id                   String                      @id @default(cuid())
  name                 String                      @unique
  // A tenant of the MSP, set by the platform: its database servers give single databases to other
  // tenants, see src/services/tenant/shared-servers.ts, and it shares destinations and notification
  // channels with them, see src/services/sharing/. It may also get what another tenant shares.
  sharesWithCustomers  Boolean                     @default(false)
  // What the tenant may add itself, set by the platform. Off stops new ones, what it has keeps
  // working, see src/services/tenant/tenant-allowances.ts.
  addsDatabases        Boolean                     @default(true)
  addsDirectorySources Boolean                     @default(true)
  addsDestinations     Boolean                     @default(true)
  addsChannels         Boolean                     @default(true)
  // Whether it makes API keys itself. Off stops new keys and the keys it has, which work again once
  // it is on, see src/services/auth/api-key-service.ts.
  addsApiKeys          Boolean                     @default(true)
  // Whether its connections reach the local network of the server DBackup runs on, set by the
  // platform: loopback, private, link-local and VPN addresses, see src/lib/network/local-network.ts.
  // On for a new tenant, off for the tenants made before it existed. The home tenant is the
  // platform and never blocked, whatever this says, see src/services/tenant/tenant-network.ts.
  blocksLocalNetwork   Boolean                     @default(true)
  // The ranges it reaches anyway while it blocks the local network, a JSON array like
  // ["10.10.10.0/24", "fd00:1::/64"].
  allowedNetworks      String                      @default("[]")
  // How many backups a day it may start of each database other tenants give it, set by the platform,
  // null for none. A database or a rule that sets its own keeps that, see src/lib/tenant/sharing.ts.
  onDemandPerDay       Int?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  memberships          TenantMembership[]
  invitations          TenantInvitation[]
  logo                 TenantLogo?
  platformGroups       PlatformGroupTenant[]
  groupTemplates       TenantGroupTemplateTenant[]
}

// The logo of a tenant, which the head of the sidebar and the tenant switcher show.
model TenantLogo {
  tenantId  String   @id
  mimeType  String // image/png, image/jpeg, image/gif, image/webp or image/svg+xml, read from the bytes
  size      Int
  data      Bytes
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Who works in a tenant, and with which role. One account can be a member of several tenants.
model TenantMembership {
  userId    String
  tenantId  String
  groupId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id])

  @@id([userId, tenantId])
  @@index([tenantId])
  @@index([groupId])
}

// A link a tenant admin hands out to add someone to the tenant. Only the hash of its token is
// kept, and it works once until it runs out.
model TenantInvitation {
  id            String    @id @default(cuid())
  tenantId      String
  groupId       String
  tokenHash     String    @unique
  // Who the link is meant for, as the admin wrote it. Only shown, never checked.
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  acceptedAt    DateTime?
  acceptedById  String?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// A database server of a tenant whose databases are given to customers. The id is the one of its
// connection, and it stays when the connection is deleted, with the name and the engine the server
// had: its customers keep the backups of their time to download, and the assignments and rules
// stay. See src/services/tenant/shared-servers.ts.
model SharedServer {
  id          String                   @id
  name        String
  adapterId   String
  // When the connection was deleted. Its databases only download from then on, unless one moved
  // to another server before.
  deletedAt   DateTime?
  createdAt   DateTime                 @default(now())
  assignments DatabaseAssignment[]
  rules       DatabaseAssignmentRule[]
  // The tenant of the server, see AdapterConfig.tenantId.
  tenantId    String

  @@index([tenantId])
}

// One database of a shared server, the source of another tenant, given to a customer. The job of the
// server's tenant backs it up with all the others, the customer sees the backups of this database
// alone and restores it into itself. An assignment ends rather than being deleted, so the backups of
// a name a new customer takes over later stay with the one it belonged to then.
model DatabaseAssignment {
  id              String       @id @default(cuid())
  // The connection of the server, kept as it was after the connection is deleted.
  sourceId        String
  databaseName    String
  // The customer, not the tenant of the server. Null when the server's tenant took the database
  // back, which no rule overrides. No relation: the id of a deleted tenant stays, so the backups of
  // its time stay with nobody instead of falling to whoever a rule names.
  tenantId        String?
  // The customer sees the backups made from here on, and up to the end.
  validFrom       DateTime
  validUntil      DateTime?
  // Set on the assignment a move ended: the server and the name the database lives on since,
  // where an assignment of the same customer starts at the end of this one.
  movedToSourceId String?
  movedToDatabase String?
  // How many backups of it a day the customer may start: null as many as the customer may of every
  // database (Tenant.onDemandPerDay), 0 none, else the number of its own.
  onDemandPerDay  Int?
  createdAt       DateTime     @default(now())
  createdById     String?
  server          SharedServer @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, databaseName])
  @@index([tenantId])
}

// Gives the databases of a shared server whose names match a pattern, like "shop_*", to a customer.
// An assignment of the name itself wins over every rule, and of several rules the highest priority.
model DatabaseAssignmentRule {
  id             String       @id @default(cuid())
  sourceId       String
  pattern        String
  // The customer. No relation, for the same reason as DatabaseAssignment.tenantId.
  tenantId       String
  priority       Int          @default(0)
  validFrom      DateTime
  // When the rule was removed, or its tenant deleted. It still decides the backups of its time.
  validUntil     DateTime?
  // How many backups a day the customer may start of each database the rule gives, like
  // DatabaseAssignment.onDemandPerDay: null as the customer, 0 none, else its own.
  onDemandPerDay Int?
  createdAt      DateTime     @default(now())
  server         SharedServer @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([tenantId])
}

// A backup a customer started of a database given to them. It counts towards the backups of that
// day the assignment allows and lets the customer follow the run, which belongs to the tenant of
// the server and which the customer never opens itself.
model SharedBackupRequest {
  id            String   @id @default(cuid())
  sourceId      String
  databaseName  String
  executionId   String
  requestedById String?
  createdAt     DateTime @default(now())
  // The customer that asked, see AdapterConfig.tenantId.
  tenantId      String

  @@index([tenantId, sourceId, databaseName, createdAt])
}

model UserPreference {
  userId    String
  /// Namespaced, e.g. "table:connections.databases".
  key       String
  /// JSON. The service that owns the key validates it on the way in and out.
  value     String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Group {
  id          String               @id @default(uuid())
  name        String
  permissions String // Stored as JSON
  // The role with every permission of its tenant, now and in later versions. The permission sync
  // keeps it complete, and nobody edits or deletes it. The SuperAdmin group of earlier versions.
  fullAccess  Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  // A group belongs to one tenant, whose admins make and change it. See AdapterConfig.tenantId.
  tenantId    String               @default("default")
  // Who holds it in its tenant.
  memberships TenantMembership[]
  invitations TenantInvitation[]
  // A group the platform made for tenants, which this one is in its tenant. The tenant's admins give
  // it to people, only the platform changes, renames or deletes it. See TenantGroupTemplate.
  templateId  String?
  template    TenantGroupTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@unique([tenantId, templateId])
  @@index([tenantId])
}

// A group the platform makes once and gives to tenants, see src/services/user/tenant-group-templates.ts.
// Every tenant it reaches has a Group linked to it, which follows its name and its permissions.
model TenantGroupTemplate {
  id          String                      @id @default(uuid())
  name        String                      @unique
  // The permissions in a tenant, a JSON list like the permissions of a group.
  permissions String                      @default("[]")
  // Every tenant, the ones made later too. Otherwise the tenants listed in `tenants`.
  allTenants  Boolean                     @default(false)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  tenants     TenantGroupTemplateTenant[]
  groups      Group[]
}

// A tenant a group for tenants reaches while it does not reach every tenant.
model TenantGroupTemplateTenant {
  templateId String
  tenantId   String
  template   TenantGroupTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([templateId, tenantId])
  @@index([tenantId])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(false)
  // Rate limiting fields required by better-auth >= 1.6 two-factor plugin.
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The tenant this session works in, which every device picks on its own. Checked against the
  // memberships on every request, so a removed membership ends it.
  activeTenantId String?
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model SsoProvider {
  id             String  @id @default(cuid())
  providerId     String  @unique // e.g. "authentik-main"
  type           String  @default("oidc") // "oidc" or "saml"
  domain         String? // Required by better-auth SSO plugin for email domain matching
  domainVerified Boolean @default(false) // Required by better-auth for trusted provider status

  // OIDC Specific Fields (Managed by Better-Auth)
  oidcConfig String? // JSON string containing issuer, clientId, clientSecret, etc.
  samlConfig String? // JSON string containing spMetadata, idpMetadata, etc.

  // Legacy/UI Specific Fields (Kept for UI convenience, synced with oidcConfig)
  issuer                String?
  authorizationEndpoint String?
  tokenEndpoint         String?
  userInfoEndpoint      String?
  jwksEndpoint          String?

  // Credentials
  clientId     String?
  clientSecret String?

  // Custom App Logic
  adapterId         String // e.g. "authentik", "pocket-id"
  adapterConfig     String? // JSON string storing the raw inputs used to generate the config (e.g. { "url": "...", "realm": "..." })
  name              String // Display Name e.g. "Corporate Login"
  enabled           Boolean @default(true)
  allowProvisioning Boolean @default(true) // Whether to create new users automatically
  defaultGroupId    String? // The group a user the provider creates starts in, none leaves them without a group

  userId String? // Optional: If linked to a specific user (Account Linking) logic, usually null for global SSO

  // The tenant that brings this provider, null for one of the platform. A tenant's provider is
  // reached by the domain of an email, never as a button, and the people it adds join that tenant.
  tenantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Log-Eintrag für jeden Prüfzyklus (wird regelmäßig bereinigt)
model HealthCheckLog {
  id              String   @id @default(uuid())
  adapterConfigId String
  status          String // ONLINE, DEGRADED, OFFLINE
  latencyMs       Int // Antwortzeit in Millisekunden
  error           String? // Fehlermeldung falls fehlgeschlagen
  createdAt       DateTime @default(now())

  adapterConfig AdapterConfig @relation(fields: [adapterConfigId], references: [id], onDelete: Cascade)

  @@index([adapterConfigId, createdAt])
}

// Persistent history of database engine version changes detected by the
// "Update Database Versions" system task. One row is inserted only when the
// detected version differs from the latest stored entry for the same source.
model DbVersionHistory {
  id              String   @id @default(uuid())
  adapterConfigId String
  previousVersion String? // null for the first recorded entry per source
  newVersion      String
  edition         String? // optional adapter-specific info (e.g. MSSQL edition)
  detectedAt      DateTime @default(now())

  adapterConfig AdapterConfig @relation(fields: [adapterConfigId], references: [id], onDelete: Cascade)

  @@index([adapterConfigId, detectedAt])
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String? // Nullable because some actions might be system actions or deleted users
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The name of the user when the entry was written, so it stays after the user is deleted
  actorName  String?
  // The API key the request came with, and its name at the time
  apiKeyId   String?
  apiKeyName String?

  action     String // ENUM-like string: "LOGIN", "LOGIN_FAILED", "CREATE", "UPDATE", "DELETE", "RESTORE", ...
  resource   String // ENUM-like string: "USER", "JOB", "BACKUP", "SYSTEM", ...
  resourceId String? // The ID of the affected object

  details   String? // JSON string storing changes (diff) or connection info
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  tenantId  String   @default("default") // See AdapterConfig.tenantId

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String // First 16 chars of raw key for UI identification (e.g. "dbackup_a3f2b1c8")
  hashedKey   String    @unique // SHA-256 hash of the full key
  permissions String // JSON array of permission strings (same format as Group.permissions)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime? // Optional expiration date
  lastUsedAt  DateTime? // Updated on each successful authentication
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  tenantId    String    @default("default") // See AdapterConfig.tenantId

  @@index([hashedKey])
  @@index([userId])
  @@index([tenantId])
}

model StorageSnapshot {
  id              String   @id @default(uuid())
  adapterConfigId String
  adapterName     String
  adapterId       String // e.g. "local", "s3", "dropbox"
  size            BigInt   @default(0)
  count           Int      @default(0)
  createdAt       DateTime @default(now())
  tenantId        String   @default("default") // See AdapterConfig.tenantId

  // The newest snapshot of a destination before a point in time, for the storage trend of the
  // dashboard, the alerts and the last scan of a destination that does not answer.
  @@index([adapterConfigId, createdAt])
  @@index([createdAt])
  @@index([tenantId])
}

// Tracks every notification sent through any adapter (per-job or system)
model NotificationLog {
  id              String   @id @default(uuid())
  eventType       String // e.g. "backup_success", "user_login"
  channelId       String? // AdapterConfig.id (nullable if channel was deleted)
  channelName     String // Display name snapshot at send time
  adapterId       String // e.g. "discord", "email", "slack"
  status          String // "Success" | "Failed"
  title           String // Notification title / email subject
  message         String // Plain text body
  fields          String? // JSON array of { name, value, inline? }
  color           String? // Hex color used
  renderedHtml    String? // Pre-rendered HTML (email only)
  renderedPayload String? // JSON of adapter-specific payload (Discord embed, Slack blocks, etc.)
  error           String? // Error message if failed
  executionId     String? // Link to Execution if triggered by backup/restore
  sentAt          DateTime @default(now())
  tenantId        String   @default("default") // See AdapterConfig.tenantId

  @@index([eventType])
  @@index([adapterId])
  @@index([sentAt])
  @@index([executionId])
  @@index([tenantId, sentAt])
}

model StorageListCache {
  adapterConfigId String
  // The tenant whose backups the listing holds: the tenant of the destination, or a tenant it is
  // shared with, whose backups sit under tenants/<id>/ on it. See src/lib/tenant/storage-view.ts.
  tenantId        String
  filesJson       String
  cachedAt        DateTime      @default(now())
  adapterConfig   AdapterConfig @relation(fields: [adapterConfigId], references: [id], onDelete: Cascade)

  @@id([adapterConfigId, tenantId])
  @@index([tenantId])
}

// A destination or a notification channel that a tenant of the MSP shares with other tenants. The
// id is the one of the connection, which stays in the tenant that shares it: a customer uses it in
// its jobs and templates, never sees its address or login, and never changes it. Who gets it is
// every other tenant, or the tenants of ConnectionShareTenant. See src/services/sharing/.
model ConnectionShare {
  id            String                  @id
  // Every other tenant, a new one too. Else only the tenants listed.
  allTenants    Boolean                 @default(false)
  // A destination: a job of a customer writes to it only with a key of its own Vault.
  encryptedOnly Boolean                 @default(false)
  // An email channel: each customer names its own recipients. Else it sends to the recipients of
  // the channel, like a support desk of the MSP that hears about the runs of its customers.
  ownRecipients Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  config        AdapterConfig           @relation(fields: [id], references: [id], onDelete: Cascade)
  tenants       ConnectionShareTenant[]
  // The tenant of the connection, the one that shares it.
  tenantId      String

  @@index([tenantId])
}

// A tenant a connection is shared with, when it is not shared with every tenant.
model ConnectionShareTenant {
  shareId   String
  // The customer, not the tenant of the connection. No relation, a deleted tenant is taken out by
  // tenantService.delete.
  tenantId  String
  createdAt DateTime        @default(now())
  share     ConnectionShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@id([shareId, tenantId])
  @@index([tenantId])
}

// The recipients a tenant names for an email channel another tenant shares with it. The server,
// the login and the sender stay with the tenant that shares it.
model ChannelRecipients {
  id         String        @id @default(cuid())
  configId   String
  // A JSON array of email addresses.
  recipients String
  updatedAt  DateTime      @updatedAt
  config     AdapterConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  // The tenant that names them, not the tenant of the channel.
  tenantId   String

  @@unique([tenantId, configId])
}

// The databases of a database connection as the Database Explorer lists them. Read every hour by
// the version task and on Read now. A failed read keeps the last list and only records why.
model DatabaseListCache {
  adapterConfigId String        @id
  databasesJson   String        @default("[]") // JSON array of { name, sizeInBytes?, tableCount? }
  readAt          DateTime? // When the list was last read in full
  error           String? // Why the latest read failed, cleared by the next good one
  attemptedAt     DateTime      @default(now())
  adapterConfig   AdapterConfig @relation(fields: [adapterConfigId], references: [id], onDelete: Cascade)
}

// A record moved to Recently deleted, with everything that belonged to it, until it is restored or its
// time under Data retention is up. The record itself is deleted for real, so no query anywhere has to
// leave it out and its name is free again.
model DeletedRecord {
  id             String   @id @default(uuid())
  kind           String // encryptionKey | credential | connection | job | user
  recordId       String // The id it had, and gets back
  name           String // Its name when it was deleted
  detail         String? // One line under the name, like the key id or the email
  data           String // JSON snapshot of the record and what belonged to it, secrets as they were stored
  permission     String // The permission that restores or purges it, like destinations:write for a destination
  superAdminOnly Boolean  @default(false) // The account of a platform admin, which only a platform admin brings back
  deletedAt      DateTime @default(now())
  deletedById    String?
  deletedByName  String?
  tenantId       String   @default("default") // See AdapterConfig.tenantId

  @@index([kind])
  @@index([deletedAt])
  @@index([tenantId])
}

// The picture of the login page under Settings, Sign-in, one row at most. It shows to everyone who
// opens the login page while Your own image is picked, so nothing in it is private.
model LoginImage {
  id        String   @id @default("login")
  fileName  String
  mimeType  String // image/png, image/jpeg or image/webp, read from the bytes
  size      Int
  data      Bytes
  updatedAt DateTime @updatedAt
}

// The picture of a person, in the database like the one of the login page, so a configuration
// backup brings it back. User.image holds its address with the time of the picture.
model Avatar {
  userId    String   @id
  mimeType  String // image/png, image/jpeg, image/gif or image/webp, read from the bytes
  size      Int
  data      Bytes
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
