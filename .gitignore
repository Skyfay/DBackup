# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.test

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# db
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db-shm
prisma/dev.db-wal
db-data/

# backups
backups/

# persistent data (Docker mount point)
data/

# Jetbrains
.idea

# Claude Code - share agents, skills and launch config, keep personal settings local
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/launch.json

# VSCode
.vscode

# Security Audits
security/*
# SSH key pair generated for the integration tests
.ssh-test/

# The sponsors workflow installs sponsorkit and writes its images here, never committed
.github/sponsors/node_modules/
.github/sponsors/sponsorkit/
